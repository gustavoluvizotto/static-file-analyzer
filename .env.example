# Copy to .env to override docker-compose.yml defaults. Environment variables
# take precedence over this file. run_isolated.sh sets TRIAGE_SAMPLES,
# TRIAGE_RULES and TRIAGE_SELINUX itself.

# Image and build
#TRIAGE_IMAGE=triage:0.1.0
#TRIAGE_PYTHON_IMAGE=docker.io/library/python:3.12-slim@sha256:<digest>
#TRIAGE_UID=10001
#TRIAGE_GID=10001

# Resource limits
#TRIAGE_MEMORY=1g
#TRIAGE_CPUS=2
#TRIAGE_PIDS=64

# Mounts (for direct `docker compose run` use)
#TRIAGE_SAMPLES=/absolute/path/to/samples
#TRIAGE_RULES=/absolute/path/to/rules
#TRIAGE_SELINUX=,Z
